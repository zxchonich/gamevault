# Скопіюйте у .env і заповніть значення.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=game_library_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Ключ: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Пошта. Якщо EMAIL_HOST порожній, листи виводяться в консоль runserver.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=адреса, EMAIL_HOST_PASSWORD=пароль застосунку
# (https://myaccount.google.com/apppasswords, потрібна двоетапна перевірка).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GameVault <noreply@gamevault.local>

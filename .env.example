# Скопіюйте у .env і заповніть значення.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=game_library_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Ключ: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Фонова синхронізація Steam-бібліотек користувачів, що увійшли, і її інтервал у годинах.
STEAM_AUTOSYNC=True
STEAM_AUTOSYNC_HOURS=6
# Хто зараз у грі: опитування Steam (секунди між опитуваннями).
STEAM_PRESENCE=True
STEAM_PRESENCE_INTERVAL=60

# Пошта. Якщо EMAIL_HOST порожній, листи виводяться в консоль runserver.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=адреса, EMAIL_HOST_PASSWORD=пароль застосунку
# (https://myaccount.google.com/apppasswords, потрібна двоетапна перевірка).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GameVault <noreply@gamevault.local>

# Вхід через Google: https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application),
# Authorized redirect URI: http://127.0.0.1:8000/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
